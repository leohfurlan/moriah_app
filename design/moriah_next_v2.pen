                        {
                          "type": "text",
                          "id": "qlrOo",
                          "name": "Text",
                          "fill": "#344054",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "[Intro]\nE   A   C#m   B\n\n[Verso]\nE\nUma coisa eu peço ao Senhor\nA\nE a buscarei\nC#m\nQue eu possa habitar em Tua casa\nB\nTodos os dias...\n\n[Refrão]\nA\nTu és a boa parte\nE\nQue eu escolhi\nC#m\nNada é melhor\nB\nDo que estar aqui\n\n[Ponte]\nA\nMeu coração encontrou\nE\nO lugar onde quer permanecer",
                          "lineHeight": 1.12,
                          "fontFamily": "Inter",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        }
                      ]
