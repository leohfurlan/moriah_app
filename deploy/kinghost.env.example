# Copy to /opt/moriah_app/.env.pilot, chmod 600, fill on the server.
APP_REVISION=REPLACE_WITH_VALIDATED_RELEASE
PILOT_BIND=127.0.0.1
PILOT_PORT=18020
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
# localhost is required by the internal healthcheck.
DJANGO_ALLOWED_HOSTS=app.igrejamoriah.com,localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_TRUST_PROXY_SSL_HEADER=true
CORS_ALLOWED_ORIGINS=https://app.igrejamoriah.com
CSRF_TRUSTED_ORIGINS=https://app.igrejamoriah.com
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=moriah
POSTGRES_USER=moriah_app
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_DATABASE_ADMIN_PASSWORD
POSTGRES_SSLMODE=disable
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONN_HEALTH_CHECKS=true
USE_S3_STORAGE=false
PRIVATE_LOCAL_MEDIA=true
LOCAL_MEDIA_PERSISTENT=true
LOCAL_MEDIA_URL_EXPIRE_SECONDS=900
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
DJANGO_LOG_LEVEL=INFO
DJANGO_DB_LOG_LEVEL=WARNING
