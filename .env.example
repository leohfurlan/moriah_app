POSTGRES_DB=moriah
POSTGRES_USER=moriah
POSTGRES_PASSWORD=moriah
POSTGRES_HOST=db
POSTGRES_PORT=5432
# TLS e reuso de conexao. Obrigatorios quando o banco e remoto (Neon):
# sem POSTGRES_SSLMODE=require o `manage.py check --deploy` falha.
POSTGRES_SSLMODE=
# 0 em dev (runserver); 60 em producao evita abrir conexao nova por requisicao.
POSTGRES_CONN_MAX_AGE=0
POSTGRES_CONN_HEALTH_CHECKS=true

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=America/Sao_Paulo
# Revisao implantada; o CI passa o commit para aparecer em /health/.
APP_REVISION=dev
# Niveis de log (DEBUG/INFO/WARNING/ERROR). Em container o log vai para stdout.
DJANGO_LOG_LEVEL=INFO
# Log de SQL: deixe em WARNING (DEBUG registra cada consulta e vaza dado).
DJANGO_DB_LOG_LEVEL=WARNING
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://192.168.24.7:8081,http://localhost:19006,http://127.0.0.1:19006,exp://127.0.0.1:19000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

EXPO_PUBLIC_API_URL=http://localhost:8000/backend

# --- Storage de comprovantes -------------------------------------------------
# Em dev (false) os anexos ficam em backend/media/. Em homologacao/producao
# ligue e aponte para S3 ou Cloudflare R2 — o disco do container e efemero.
USE_S3_STORAGE=false
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2: https://<accountid>.r2.cloudflarestorage.com | AWS S3: deixe vazio
S3_ENDPOINT_URL=
S3_REGION_NAME=auto
# Validade (segundos) das URLs assinadas dos comprovantes.
S3_URL_EXPIRE_SECONDS=900

# --- Producao ----------------------------------------------------------------
# Fora do modo debug o Django assume HTTPS (HSTS, cookies secure, redirect).
# Os endpoints /health/ e /health/ready/ ficam isentos do redirect para que o
# healthcheck do Docker funcione dentro do container.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=31536000
# Ligue quando houver proxy/tunel HTTPS na frente (nginx, ngrok, load balancer)
# para que as URLs absolutas geradas pelo Django usem https.
DJANGO_TRUST_PROXY_SSL_HEADER=false

# --- Piloto (docker-compose.pilot.yml) ---------------------------------------
# Sem o servico db: aponte POSTGRES_HOST para o host gerenciado (Neon) e use
# POSTGRES_SSLMODE=require. O arquivo real de piloto e .env.pilot (nao commitado).
#
#   PILOT_BIND=127.0.0.1     interface publicada pelo compose (proxy na frente)
#   PILOT_PORT=8000
#   GUNICORN_WORKERS=3
#   GUNICORN_THREADS=2
#   GUNICORN_TIMEOUT=60

# --- Backup ------------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
# Endpoint que recebe POST {"text": "..."} quando o backup falha (Slack/Discord/n8n).
BACKUP_ALERT_WEBHOOK=
# Carimbo do ultimo backup bom; e o que um vigia deve monitorar ("backup parou").
BACKUP_HEALTH_FILE=
